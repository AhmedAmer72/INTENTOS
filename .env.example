# INTENTOS environment — copy to .env and fill in.
# Never commit real keys. Generate wallets with: pnpm provision
#
# Fail-closed: compile / propose / verify refuse to run without Router, AGENT_ID,
# storage upload, and a real principal wallet. There is no regex-only demo path.

# ── Wallets (hex private keys, 0x-prefixed) ──────────────────────────────────
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
VERIFIER_ORACLE_PRIVATE_KEY=0xYOUR_ORACLE_PRIVATE_KEY

# ── 0G Chain ─────────────────────────────────────────────────────────────────
# galileo (testnet, chainId 16602) | mainnet (Aristotle, chainId 16661)
ZEROG_NETWORK=mainnet
ZEROG_TESTNET_RPC=https://evmrpc-testnet.0g.ai
ZEROG_MAINNET_RPC=https://evmrpc.0g.ai
ZEROG_TESTNET_EXPLORER=https://chainscan-galileo.0g.ai
ZEROG_MAINNET_EXPLORER=https://chainscan.0g.ai

INTENT_REGISTRY_ADDRESS=
DEMO_VAULT_ADDRESS=
VERIFICATION_METER_ADDRESS=
CERTIFICATE_CONSUMER_ADDRESS=
AGENTIC_ID_ADDRESS=
AGENTIC_ID_TOKEN=
INTENT_EXECUTOR_ADDRESS=
SETTLEMENT_TARGET_ADDRESS=
INTENT_BOUNTY_ADDRESS=
AGENTIC_ID_V2_ADDRESS=
AGENTIC_ID_V2_TOKEN=
CHALLENGE_DELAY_SECONDS=900
VERIFY_PRICE_WEI=100000000000000

# ── 0G Storage ───────────────────────────────────────────────────────────────
ZEROG_STORAGE_INDEXER_TESTNET=https://indexer-storage-testnet-turbo.0g.ai
ZEROG_STORAGE_INDEXER_MAINNET=https://indexer-storage-turbo.0g.ai
# Required for /verify. Local keccak commitments are disabled.
ZEROG_STORAGE_UPLOAD=1

# ── 0G Compute Router ────────────────────────────────────────────────────────
# Testnet UI: https://pc.testnet.0g.ai  → Dashboard → API Keys
# Mainnet UI: https://pc.0g.ai          → Dashboard → API Keys
ZEROG_ROUTER_URL_TESTNET=https://router-api-testnet.integratenetwork.work/v1
ZEROG_ROUTER_URL_MAINNET=https://router-api.0g.ai/v1
ZEROG_ROUTER_API_KEY=
# Pin a TEE-attested *chat* model from GET /v1/models?tee_attested=true
# Mainnet: qwen3.8-flash. Galileo: qwen2.5-omni. Image models will 404 on compile.
ZEROG_ROUTER_MODEL=qwen3.8-flash

# ── ERC-8004 agent identity (already deployed by 0G) ─────────────────────────
ERC8004_IDENTITY_REGISTRY_TESTNET=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_IDENTITY_REGISTRY_MAINNET=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY_TESTNET=0x8004B663056A597Dffe9eCcC1965A193B7388713
ERC8004_REPUTATION_REGISTRY_MAINNET=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
AGENT_TOKEN_URI=https://intentos.ai/agent/reference.json
AGENT_ID=
REQUIREMENT_AGENT_ID=

# ── Database (Prisma; SQLite by default, Postgres via docker compose) ────────
DATABASE_URL=file:./dev.db

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=8787
API_HOST=127.0.0.1
# Render sets PORT and should use API_HOST=0.0.0.0 (see docs/deploy.md).

# ── Web (Vite) ───────────────────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8787
VITE_CHAIN_ID=16661
# Vercel: set VITE_API_URL to the public Render API origin (no trailing slash).
# React Bits Pro — put this in apps/web/.env.local to install @reactbits-starter/*
# REACTBITS_LICENSE_KEY=
